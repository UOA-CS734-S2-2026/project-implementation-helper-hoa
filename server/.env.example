# Copy to server/.env and fill in the blanks:  cp server/.env.example server/.env
#
# This is the single source for the Express server's configuration. The server
# also reads <project root>/.env, but only for variables shared with the Python
# tier. Anything listed here belongs in this file, not in the root one.

# Port the Express server listens on.
PORT=3000

# Firebase Web API key. Used only to mint ID tokens for the demo seed accounts
# via the Identity Toolkit REST API (src/services/auth.service.ts,
# src/scripts/get-token.ts). Firebase console > Project settings > General.
FIREBASE_WEB_API_KEY=

# Optional overrides for src/scripts/seed.ts and src/scripts/get-token.ts.
# Unset, the code falls back to these same values.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_USER_PASSWORD=password123

# ---------------------------------------------------------------------------
# Not an environment variable
# ---------------------------------------------------------------------------
# The Firebase Admin SDK credential is read from disk, not from the
# environment: place service-account.json in server/ and it will be found
# (src/config/firebase.ts). Download it from Firebase console >
# Project settings > Service accounts. It is git-ignored.
#
# The project id comes from that file, so nothing needs configuring here. For
# the configured Android app it is helperhoa-5f706.
