# Copy to .env and fill in the blanks:  cp .env.example .env
#
# Shared configuration, plus everything the Python tier reads. The Express
# server keeps its own configuration in server/.env -- only variables that both
# tiers genuinely need belong in this file.

# --- Shared with the server tier ---

# Shared secret the chatbot presents to the Express server, which verifies it on
# every MCP call. Both tiers must agree on this value.
MCP_SECRET=

# --- Python tier ---

# Base URL of the Express server that mcp_chatbot.py calls.
MCP_API_BASE_URL=http://localhost:3000

# Port chatbot_server.py listens on.
PYTHON_AI_PORT=8000

# UoA gateway, used by llm.py.
UOA_API_KEY=
UOA_BASE_URL=https://agent.elliottwen.info/v1
UOA_MODEL=MiniMax-M3

# Llama Cloud API key, used by the scanner tier (scan_service.py).
LLAMA_CLOUD_API_KEY=

# ---------------------------------------------------------------------------
# React admin panel (development only) -- web-admin/vite.config.ts
# ---------------------------------------------------------------------------
# The Vite dev server signs in with these to obtain an admin Firebase ID token
# and refreshes it automatically, so it never sends an expired token. They default
# to the seeded demo admin; override only if you seeded different credentials.
# Never put these in VITE_* variables -- those are included in the browser bundle.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123

# ---------------------------------------------------------------------------
# Flutter app (development only)
# ---------------------------------------------------------------------------
# Dev bypass token for DevTestTokenProvider in lib/services/dev_test_token_provider.dart.
# Leave blank in normal use: the app then sends the signed-in user's ID token.
# The React admin panel no longer reads this; it signs in with ADMIN_EMAIL/ADMIN_PASSWORD.
DEV_TEST_ID_TOKEN=

# ---------------------------------------------------------------------------
# Not configured anywhere, by design
# ---------------------------------------------------------------------------
# TOKEN              injected per request by chatbot_server.py into the
#                    mcp_chatbot.py subprocess environment. Never put it here.
# FIREBASE_PROJECT_ID
#                    the Firebase project is taken from the Admin SDK credential
#                    (server/service-account.json or Application Default Credentials),
#                    not from the environment. For this repo the Admin SDK project is
#                    helperhoa-5f706; the Flutter Android client uses helper-hoa-sc.
#                    Note: the stale comment mentioning helperhoa-cef06 is outdated.
